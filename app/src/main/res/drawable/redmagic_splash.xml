<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/redmagic_splash_vector">
    <target
        android:name="frame_top"
        android:animation="@animator/splash_draw_immediate" />
    <target
        android:name="frame_right"
        android:animation="@animator/splash_draw_1" />
    <target
        android:name="frame_bottom"
        android:animation="@animator/splash_draw_2" />
    <target
        android:name="frame_left"
        android:animation="@animator/splash_draw_3" />
    <target
        android:name="redmagic_mark"
        android:animation="@animator/splash_draw_mark" />
</animated-vector>
